    "scenarios": [
      "No discount, threshold, graduated-tier and continuous-formula volume discounts",
      "Organization-level aggregation across two resources",
      "Affiliate links with different fees and an inactive link",
      "Affiliate fee accruals per invoice",
      "Credit ledger: earned fees, promotional grant, withdrawable adjustment and payout"
    ]
  },
