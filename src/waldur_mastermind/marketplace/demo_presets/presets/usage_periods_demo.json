{
  "_metadata": {
    "title": "Usage periods demo",
    "description": "Minimal demo preset that exercises every OfferingComponent.limit_period (MONTH, QUARTERLY, ANNUAL, TOTAL) and both billing_types (limit, usage) so the per-offering /components-usage/ endpoint and the Customer/Project dashboard usage widget can be verified end-to-end. Includes six months of historic ComponentUsage so quarterly/annual/total aggregations differ from the current-month value, plus a 10-project distribution to support the by-project decomposition and crosses-limit projection demos.",
    "version": "1.4.0",
    "scenarios": [
      "Per-offering current-period usage stats endpoint",
      "Quarterly limit_period reports quarter-to-date",
      "Annual limit_period reports year-to-date",
      "Total limit_period reports lifetime",
      "Mixed limit and usage billing on same dashboard",
      "SLURM compute offerings with slurm_periodic_policy_enabled",
      "Both 'lean' and 'full' SLURM plugin_options flavors",
      "By-project decomposition (10 projects share one offering) \u2014 supports the by-project chart and 'View all' modal",
      "Crosses-limit projection \u2014 quarterly compute offering at 87% of limit at end of May with linear forward rate that crosses cap in mid-June"
    ]
  },
