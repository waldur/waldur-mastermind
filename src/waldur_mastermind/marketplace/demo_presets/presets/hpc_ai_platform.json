              "default_lb_system_disk_gb": 50,
              "default_lb_logs_disk_gb": 100,
              "minimal_worker_vcpus": 16,
              "minimal_worker_ram_gb": 64,
              "default_worker_data_disk_gb": 2000,
              "default_storage_data_disk_gb": 5000,
              "default_storage_san_disk_gb": 20000,
              "available_kubernetes_versions": "1.28.0,1.29.0,1.30.0"
            }
          }
        }
      },
      "plugin_options": {
        "backend_type": "k8s-ai-ml",
        "service_type": "kubernetes-cluster",
        "deployment_mode": "managed",
        "gpu_operator": true,
        "kubeflow_enabled": true,
        "infiniband_support": true,
        "service_provider_can_create_offering_user": true
      },
      "getting_started": "## Getting Started with AI/ML Kubernetes\n\n### Access\n```\nexport KUBECONFIG=~/Downloads/kubeconfig-aiml.yaml\nkubectl get nodes -l nvidia.com/gpu.present=true\n```\n\n### GPU Workloads\n```yaml\napiVersion: v1\nkind: Pod\nspec:\n  containers:\n  - name: cuda-container\n    resources:\n      limits:\n        nvidia.com/gpu: 8\n```\n\n### Kubeflow\nAccess the Kubeflow dashboard for:\n- Jupyter notebooks\n- Training operators (PyTorch, TensorFlow)\n- Model serving (KServe)\n\n### Distributed Training\n- Use PyTorchJob for multi-node training\n- NCCL over InfiniBand for high bandwidth\n\n### Support\nEmail: ai-support@aiplatform.com"
    },
    {
      "uuid": "f3000000000000000000000000000020",
