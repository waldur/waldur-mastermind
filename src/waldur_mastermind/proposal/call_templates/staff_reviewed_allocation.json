  ],
  "checklists": [
    {
      "name": "Final report",
      "checklist_type": "workflow_step",
      "description": "The results of an awarded project once its allocation ends.",
      "questions": [
        {
          "description": "Final results of the work",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "Report what the project achieved with the allocated resources, including publications and outcomes.",
          "rich_text_char_limit": 10000,
          "rich_text_toolbar_level": "minimal"
        },
        {
          "description": "Final report document",
          "required": false,
          "question_type": "file",
          "user_guidance": "Optional. One PDF file with the full report.",
          "allowed_file_types": [
            ".pdf"
          ],
          "allowed_mime_types": [
            "application/pdf"
          ],
          "max_file_size_mb": 10
        }
      ]
    }
  ],
  "scenarios": [
    {
      "key": "happy_path",
      "name": "Happy path",
      "description": "Eligible, feasible on every resource and approved by the call managers; the final report closes the project.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "eligible"
          },
          {
            "step": "technical_assessment",
            "outcome": "feasible"
          },
          {
            "step": "allocation_decision",
            "outcome": "approved"
          },
          {
            "final_report": true
          },
          {
            "step": "final_report",
            "outcome": "submitted"
          },
          {
            "step": "final_report_approval",
            "outcome": "approved"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "accepted"
        },
        {
          "step_status": {
            "step": "eligibility_check",
            "status": "completed",
            "outcome": "eligible"
          }
        },
        {
          "step_status": {
            "step": "allocation_decision",
            "status": "completed",
            "outcome": "approved"
          }
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_submitted"
          }
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_decided"
          }
        },
        {
          "notified": {
            "actor": "offering_team",
            "trigger": "step_started",
            "step": "technical_assessment"
          }
        },
        {
          "step_status": {
            "step": "final_report",
            "status": "completed",
            "outcome": "submitted"
          }
        },
        {
          "step_status": {
            "step": "final_report_approval",
            "status": "completed",
            "outcome": "approved"
          }
        }
      ]
    },
    {
      "key": "rejected_at_eligibility_check",
      "name": "Rejected at the eligibility check",
      "description": "The proposal is found ineligible: it is rejected, the applicant is told and no other step runs.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "ineligible"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "rejected"
        },
        {
          "step_status": {
            "step": "eligibility_check",
            "status": "completed",
            "outcome": "ineligible"
          }
        },
        {
          "step_status": {
            "step": "technical_assessment",
            "status": "pending"
          }
        },
        {
          "ends_at": "eligibility_check"
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_decided"
          }
        }
      ]
    },
    {
      "key": "infeasible_resource_still_decided",
      "name": "An infeasible resource leaves the decision to the call managers",
      "description": "The technical check finds a requested resource infeasible: the proposal is not rejected but goes on to the decision.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "eligible"
          },
          {
            "step": "technical_assessment",
            "outcome": "infeasible"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "in_review"
        },
        {
          "step_status": {
            "step": "technical_assessment",
            "status": "completed",
            "outcome": "infeasible"
          }
        },
        {
          "step_status": {
            "step": "allocation_decision",
            "status": "active"
          }
        }
      ]
    }
  ]
}
