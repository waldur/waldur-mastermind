{
  "schema_version": 3,
  "preset": {
    "process": "Staff-reviewed small allocation",
    "category": "generic",
    "tags": [
      "generic",
      "rolling",
      "staff review"
    ],
    "summary": "Small and medium allocations, continuously open: an eligibility check, a technical check per resource and a decision by the call managers."
  },
  "call": {
    "name": "Staff-reviewed allocation",
    "description": "Small and medium allocations decided by the call managers without a review panel. Continuously open: each proposal is checked for eligibility, assessed by the team of each requested resource and decided as soon as it is ready; the applicant is told the result at once. The round's budgets are spent first come, first served. Projects run six or twelve months.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": null,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "on_submission",
    "carry_over_drafts": true,
    "publish_results": "immediately",
    "undecided_at_round_completion": "refuse",
    "allowed_duration_months": [
      6,
      12
    ],
    "budget_enforcement": "hard",
    "target_decision_days": 14
  },
  "proposal_roles": [],
  "workflow_steps": [
    {
      "key": "eligibility_check",
      "kind": "decision",
      "name": "Eligibility check",
      "description": "The call managers check that the applicant and the request are eligible and the proposal complete. They may ask the applicant for changes and check the proposal again once it is resubmitted.",
      "outcome_set": "eligibility",
      "completer": "call_manager",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 3,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "none",
      "input_steps": [],
      "assigns_roles": [],
      "criteria": [],
      "checklist": null,
      "allows_change_requests": true,
      "applicant_visible": true,
      "status_labels": {
        "applicant": {
          "changes_requested": "Changes requested",
          "outcomes": {
            "eligible": "Under evaluation",
            "ineligible": "Not eligible"
          }
        },
        "evaluators": {
          "changes_requested": "Changes requested",
          "outcomes": {
            "ineligible": "Not eligible"
          }
        }
      },
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        }
      ],
      "order": 0
    },
    {
      "key": "technical_assessment",
      "kind": "assessment",
      "name": "Technical assessment",
      "description": "The team of each requested resource checks that the work can run there: accepted, conditionally accepted or rejected. A rejected resource does not stop the proposal; the call managers weigh it in the decision.",
      "outcome_set": "per_offering",
      "completer": "offering_manager",
      "completer_proposal_role": null,
      "on_negative": "continue",
      "is_enabled": true,
      "duration_in_days": 5,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "requested_offering_team",
      "input_steps": [],
      "assigns_roles": [],
      "criteria": [],
      "checklist": null,
      "per_requested_offering": true,
      "delegable_to": "offering_team",
      "status_labels": {
        "evaluators": {
          "active": "Under technical assessment",
          "completed": "Technical assessment submitted"
        }
      },
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_started",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        }
      ],
      "order": 1
    },
    {
      "key": "allocation_decision",
      "kind": "decision",
      "name": "Allocation decision",
      "description": "The call managers decide the allocation from the proposal and the technical assessment, and the applicant is told the result at once.",
      "outcome_set": "approval",
      "completer": "call_manager",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 5,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "none",
      "input_steps": [
        "technical_assessment"
      ],
      "assigns_roles": [],
      "criteria": [],
      "checklist": null,
      "is_allocation_decision": true,
      "include_award_response": false,
      "allocation_time": "on_decision",
      "status_labels": {
        "evaluators": {
          "outcomes": {
            "approved": "Awarded",
            "declined": "Not awarded"
          }
        },
        "applicant": {
          "outcomes": {
            "approved": "Awarded",
            "declined": "Not awarded"
          }
        }
      },
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_completed",
          "recipient": "offering_teams",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        }
      ],
      "order": 2
    },
    {
      "key": "final_report",
      "kind": "applicant_action",
      "name": "Final report",
      "description": "The awarded applicant submits the project's final report. The step opens at the end of the allocation period, an extension included.",
      "outcome_set": "submitted",
      "completer": "applicant",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 30,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "none",
      "input_steps": [],
      "assigns_roles": [],
      "criteria": [],
      "checklist": {
        "name": "Final report",
        "checklist_type": "workflow_step"
      },
      "applicant_visible": true,
      "phase": "closing",
      "project_end_offset_days": 0,
      "status_labels": {
        "applicant": {
          "active": "Pending final report",
          "completed": "Final report submitted"
        },
        "evaluators": {
          "active": "Pending final report",
          "completed": "Final report submitted"
        }
      },
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
