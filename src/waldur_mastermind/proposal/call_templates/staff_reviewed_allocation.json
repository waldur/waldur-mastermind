          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_started",
          "recipient": "applicant",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "applicant",
          "days_before": 7,
          "is_enabled": true,
          "notified_proposal_roles": [],
