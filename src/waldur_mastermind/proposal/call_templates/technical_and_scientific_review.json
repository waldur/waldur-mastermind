{
  "schema_version": 3,
  "preset": {
    "process": "Two-stage technical and scientific review",
    "category": "generic",
    "tags": [
      "generic",
      "cut-off",
      "peer review",
      "technical review",
      "extension"
    ],
    "summary": "A technical assessment per resource alongside external peer review, a quality threshold, then a panel meeting per cut-off."
  },
  "call": {
    "name": "Technical and scientific review",
    "description": "Large allocations awarded on technical suitability and scientific excellence. Proposals are evaluated together after each cut-off: an eligibility check, then the technical assessment by the team of each requested resource alongside two or three external peer reviews; proposals above the quality threshold go to the panel meeting, which ranks them before the call managers decide and the applicant accepts the award. Projects run twelve months and may ask for an extension with a status report.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": 365,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "at_cutoff",
    "carry_over_drafts": true,
    "publish_results": "with_round",
    "undecided_at_round_completion": "refuse",
    "target_decision_days": 120
  },
