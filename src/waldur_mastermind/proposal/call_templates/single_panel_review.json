{
  "schema_version": 3,
  "preset": {
    "process": "Single-panel peer review",
    "category": "generic",
    "tags": [
      "generic",
      "cut-off",
      "peer review",
      "panel"
    ],
    "summary": "Proposals of each cut-off are peer reviewed and ranked by one panel; the call managers decide and the applicant accepts the award."
  },
  "call": {
    "name": "Peer-reviewed allocation",
    "description": "Allocations awarded on scientific merit. Proposals are evaluated together after each cut-off: an eligibility check, two or three peer reviews, and the panel's ranking at its meeting, before the call managers decide and the applicant accepts the award. The results of a cut-off are published together. Projects run twelve months.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": 365,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "at_cutoff",
    "carry_over_drafts": true,
    "publish_results": "with_round",
    "undecided_at_round_completion": "refuse",
    "target_decision_days": 90
  },
