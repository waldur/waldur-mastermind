  "checklists": [
    {
      "name": "Panel meeting report",
      "checklist_type": "workflow_step",
      "description": "The panel's meeting for the proposals of the cut-off. Each proposal's score, rank and resource recommendation are entered in the round's ranking.",
      "questions": [
        {
          "description": "Panel comments",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "The panel's discussion of the proposals at the meeting.",
          "rich_text_char_limit": 10000,
          "rich_text_toolbar_level": "minimal"
        }
      ]
    },
    {
      "name": "Extension request",
      "checklist_type": "workflow_step",
      "description": "Why an awarded project needs more time or resources, with a status report.",
      "questions": [
        {
          "description": "Status report",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "Summarise what the project has achieved so far and how the allocated resources have been used on each resource.",
          "rich_text_char_limit": 5000,
          "rich_text_toolbar_level": "minimal"
        },
        {
          "description": "Circumstances of the request",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "Describe what calls for more time or resources, and what the extension lets the project finish.",
          "rich_text_char_limit": 5000,
          "rich_text_toolbar_level": "minimal"
        }
      ]
    },
    {
      "name": "Final report",
      "checklist_type": "workflow_step",
      "description": "The results of an awarded project once its allocation ends.",
      "questions": [
        {
          "description": "Final results of the work",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "Report what the project achieved with the allocated resources, including publications and outcomes.",
          "rich_text_char_limit": 10000,
          "rich_text_toolbar_level": "minimal"
        },
        {
          "description": "Final report document",
          "required": false,
          "question_type": "file",
          "user_guidance": "Optional. One PDF file with the full report.",
