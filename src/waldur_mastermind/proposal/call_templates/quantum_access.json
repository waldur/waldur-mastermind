{
  "schema_version": 3,
  "preset": {
    "programme": "eurohpc-ju-access",
    "process": "Quantum Access Pilot Mode",
    "reference_url": "https://eurohpc-ju.europa.eu/eurohpc-ju-call-proposals-quantum-access-pilot-mode_en",
    "reference_title": "EuroHPC JU Call for Proposals - Quantum Access Pilot Mode",
    "category": "programme",
    "tags": [
      "quantum",
      "cut-off",
      "development"
    ],
    "summary": "Three- or six-month access to EuroHPC quantum computers for tests, development and training, after monthly cut-offs."
  },
  "call": {
    "name": "Quantum Access",
    "description": "Access of three or six months to the quantum infrastructure for tests, benchmarks, code, algorithm and workflow development, and training. Continuously open with monthly cut-offs; the proposals of each cut-off get a technical assessment per quantum system, a second one after emulator benchmarks where the hosting entity asks for them, and the award follows automatically once every system has accepted.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": null,
    "allowed_duration_months": [
      3,
      6
    ],
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "at_cutoff",
    "carry_over_drafts": true,
    "publish_results": "immediately",
    "undecided_at_round_completion": "refuse",
    "applicant_cc_roles": [
      "PROPOSAL.MANAGER",
      "PROPOSAL.ADMIN"
    ]
  },
  "proposal_roles": [],
