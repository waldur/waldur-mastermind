  "scenarios": [
    {
      "key": "happy_path_and_final_report",
      "name": "Happy path and final report",
      "description": "Every partition accepts the proposal outright: the assessment after emulation is skipped, the award follows automatically and the final report is submitted and approved.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "technical_assessment",
            "outcome": "feasible"
          },
          {
            "advance": true
          },
          {
            "final_report": true
          },
          {
            "step": "final_report",
            "outcome": "submitted"
          },
          {
            "step": "final_report_approval",
            "outcome": "approved"
          }
        ]
