      "domain panels",
      "peer review"
    ],
    "summary": "Modelled on ESRF standard proposals: two deadlines a year, review panels by science area, feasibility by the instrument scientists."
  },
  "call": {
    "name": "Beamtime: standard proposals",
    "description": "Modelled on the standard proposals of the ESRF; ISIS, ILL and similar facilities run comparable panels. Two proposal deadlines a year, each a round whose proposals are evaluated together: an eligibility check (a proposal with a correctable flaw is sent back for changes), the feasibility assessment by the scientists of each requested instrument alongside the routing to the review panel of the proposal's science area, one or two referees from the panel, and the panel's meeting, which grades and ranks its proposals before the call managers decide. Panels map to generic science domains matched by code and name. The beamtime is scheduled within six months, and the experiment report is due by the next deadline.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": 183,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "at_cutoff",
    "carry_over_drafts": true,
    "publish_results": "with_round",
    "undecided_at_round_completion": "refuse",
    "target_decision_days": 60
  },
