          "min_value": 1,
          "max_value": 5
        }
      ]
    },
    {
      "name": "Sub-panel meeting report",
      "checklist_type": "workflow_step",
      "description": "The sub-panel's meeting for its proposals of the call. Each proposal's score, rank and resource recommendation are entered in the report's ranking.",
      "questions": [
        {
          "description": "Panel comments",
          "required": true,
