    "summary": "Modelled on the DiRAC Resource Allocation Committee: an annual call, assessment by domain sub-panels without external review, and a joint meeting that sets the overall allocation."
  },
  "call": {
    "name": "Domain sub-panel allocation",
    "description": "Modelled on the DiRAC Resource Allocation Committee's full call: an annual call with a mandatory technical case. Proposals are not sent to external reviewers, so there is no applicant response. Each proposal gets a technical assessment per requested resource and goes to the sub-panel of its research domain -- astronomy and cosmology, or particle and nuclear physics, matched by science domain; a proposal of another domain is moved to a panel by hand. Two sub-panel members assess it, each sub-panel ranks its proposals at its meeting, and a joint meeting sets the overall allocation. Awards start together on the call's allocation date and run twelve months.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": 365,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "at_cutoff",
    "carry_over_drafts": true,
    "publish_results": "with_round",
    "undecided_at_round_completion": "refuse",
    "target_decision_days": 150
  },
  "panels": [
