{
  "schema_version": 3,
  "preset": {
    "process": "Rapid or startup access",
    "category": "generic",
    "tags": [
      "generic",
      "rolling",
      "startup",
      "automatic"
    ],
    "summary": "Small allocations, continuously open: an eligibility check and a technical check per resource, then an automatic award."
  },
  "call": {
    "name": "Rapid access",
    "description": "Small startup allocations for testing, porting and preparing a larger proposal. Continuously open: each proposal is checked for eligibility and by the team of each requested resource as soon as it is submitted, and awarded automatically, as requested, once every resource has accepted it. A per-request cap belongs in this description and in the round's budgets, which are spent first come, first served. Projects run three or six months.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": null,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "on_submission",
    "carry_over_drafts": true,
    "publish_results": "immediately",
    "undecided_at_round_completion": "refuse",
    "allowed_duration_months": [
      3,
      6
    ],
    "budget_enforcement": "hard",
    "target_decision_days": 14
  },
  "proposal_roles": [],
  "workflow_steps": [
    {
      "key": "eligibility_check",
      "kind": "decision",
      "name": "Eligibility check",
      "description": "The call managers check that the applicant and the request are eligible: the applicant's affiliation and that the request stays within the call's cap. They may ask the applicant for changes.",
      "outcome_set": "eligibility",
      "completer": "call_manager",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 3,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "none",
      "input_steps": [],
      "assigns_roles": [],
      "criteria": [],
      "checklist": null,
      "allows_change_requests": true,
      "applicant_visible": true,
      "status_labels": {
        "applicant": {
          "changes_requested": "Changes requested",
          "outcomes": {
            "eligible": "Under evaluation",
            "ineligible": "Not eligible"
          }
        },
        "evaluators": {
          "changes_requested": "Changes requested",
          "outcomes": {
            "ineligible": "Not eligible"
          }
        }
      },
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        }
      ],
      "order": 0
    },
    {
      "key": "technical_assessment",
      "kind": "assessment",
      "name": "Technical assessment",
      "description": "The team of each requested resource checks that the work can run there: accepted, conditionally accepted or rejected. A rejected resource rejects the proposal.",
      "outcome_set": "per_offering",
      "completer": "offering_manager",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 5,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "requested_offering_team",
      "input_steps": [],
      "assigns_roles": [],
      "criteria": [],
      "checklist": null,
      "per_requested_offering": true,
      "delegable_to": "offering_team",
      "status_labels": {
        "evaluators": {
          "active": "Under technical assessment",
          "completed": "Technical assessment submitted"
        }
      },
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_started",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        }
      ],
      "order": 1
    },
    {
      "key": "allocation_decision",
      "kind": "decision",
      "name": "Allocation decision",
      "description": "Awarded automatically, as requested, once the proposal is eligible and every resource has accepted it, while the round's budgets last; the applicant is told the result at once. The call managers decide only when the award cannot be made automatically.",
      "outcome_set": "approval",
      "completer": "call_manager",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 3,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "none",
      "input_steps": [
        "eligibility_check",
        "technical_assessment"
      ],
      "assigns_roles": [],
      "criteria": [],
      "checklist": null,
      "is_allocation_decision": true,
      "include_award_response": false,
      "allocation_time": "on_decision",
      "status_labels": {
        "evaluators": {
          "outcomes": {
            "approved": "Awarded",
            "declined": "Not awarded"
          }
        }
      },
      "decides_automatically": true,
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_completed",
          "recipient": "offering_teams",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        }
      ],
      "order": 2
    },
    {
      "key": "final_report",
      "kind": "applicant_action",
      "name": "Final report",
      "description": "The awarded applicant submits the project's final report. The step opens at the end of the allocation period, an extension included.",
      "outcome_set": "submitted",
      "completer": "applicant",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 30,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "none",
      "input_steps": [],
      "assigns_roles": [],
      "criteria": [],
      "checklist": {
        "name": "Final report",
        "checklist_type": "workflow_step"
      },
      "applicant_visible": true,
      "phase": "closing",
      "project_end_offset_days": 0,
      "status_labels": {
        "applicant": {
          "active": "Pending final report",
          "completed": "Final report submitted"
        },
        "evaluators": {
          "active": "Pending final report",
          "completed": "Final report submitted"
        }
      },
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_started",
          "recipient": "applicant",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "applicant",
          "days_before": 7,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_completed",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "applicant",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        }
      ],
      "order": 3
    },
    {
      "key": "final_report_approval",
      "kind": "decision",
      "name": "Final report approval",
      "description": "The call managers approve the final report, which completes the project, or ask the applicant to change it.",
      "outcome_set": "approval",
      "completer": "call_manager",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 30,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "none",
      "input_steps": [],
      "assigns_roles": [],
      "criteria": [],
      "checklist": null,
      "allows_change_requests": true,
      "applicant_visible": true,
      "phase": "closing",
      "status_labels": {
        "applicant": {
          "active": "Final report submitted",
          "outcomes": {
            "approved": "Project completed"
          }
        },
        "evaluators": {
          "active": "Final report submitted",
          "outcomes": {
            "approved": "Project completed"
          }
        }
      },
      "notification_rules": [
        {
          "trigger": "deadline_approaching",
          "recipient": "responsible_role",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "deadline_approaching",
          "recipient": "call_managers",
          "days_before": 1,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "responsible_role",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_expired",
          "recipient": "call_managers",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        },
        {
          "trigger": "step_completed",
          "recipient": "applicant",
          "days_before": null,
          "is_enabled": true,
          "notified_proposal_roles": [],
          "proposal_role": null
        }
      ],
      "order": 4
    }
  ],
  "checklists": [
    {
      "name": "Final report",
      "checklist_type": "workflow_step",
      "description": "The results of an awarded project once its allocation ends.",
      "questions": [
        {
          "description": "Final results of the work",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "Report what the project achieved with the allocated resources, including publications and outcomes.",
          "rich_text_char_limit": 10000,
          "rich_text_toolbar_level": "minimal"
        },
        {
          "description": "Final report document",
          "required": false,
          "question_type": "file",
          "user_guidance": "Optional. One PDF file with the full report.",
          "allowed_file_types": [
            ".pdf"
          ],
          "allowed_mime_types": [
            "application/pdf"
          ],
          "max_file_size_mb": 10
        }
      ]
    }
  ],
  "scenarios": [
    {
      "key": "happy_path",
      "name": "Happy path",
      "description": "Eligible and feasible: the allocation is approved automatically; the final report closes the project.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "eligible"
          },
          {
            "step": "technical_assessment",
            "outcome": "feasible"
          },
          {
            "final_report": true
          },
          {
            "step": "final_report",
            "outcome": "submitted"
          },
          {
            "step": "final_report_approval",
            "outcome": "approved"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "accepted"
        },
        {
          "step_status": {
            "step": "eligibility_check",
            "status": "completed",
            "outcome": "eligible"
          }
        },
        {
          "step_status": {
            "step": "allocation_decision",
            "status": "completed",
            "outcome": "approved"
          }
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_submitted"
          }
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_decided"
          }
        },
        {
          "notified": {
            "actor": "offering_team",
            "trigger": "step_started",
            "step": "technical_assessment"
          }
        },
        {
          "step_status": {
            "step": "final_report",
            "status": "completed",
            "outcome": "submitted"
          }
        },
        {
          "step_status": {
            "step": "final_report_approval",
            "status": "completed",
            "outcome": "approved"
          }
        }
      ]
    },
    {
      "key": "rejected_at_eligibility_check",
      "name": "Rejected at the eligibility check",
      "description": "The proposal is found ineligible: it is rejected, the applicant is told and no other step runs.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "ineligible"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "rejected"
        },
        {
          "step_status": {
            "step": "eligibility_check",
            "status": "completed",
            "outcome": "ineligible"
          }
        },
        {
          "step_status": {
            "step": "technical_assessment",
            "status": "pending"
          }
        },
        {
          "ends_at": "eligibility_check"
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_decided"
          }
        }
      ]
    },
    {
      "key": "rejected_at_technical_assessment",
      "name": "Rejected at the technical assessment",
      "description": "A requested resource cannot run the work: the proposal is rejected and nothing is allocated.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "eligible"
          },
          {
            "step": "technical_assessment",
            "outcome": "infeasible"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "rejected"
        },
        {
          "step_status": {
            "step": "technical_assessment",
            "status": "completed",
            "outcome": "infeasible"
          }
        },
        {
          "step_status": {
            "step": "allocation_decision",
            "status": "pending"
          }
        },
        {
          "ends_at": "technical_assessment"
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_decided"
          }
        }
      ]
    }
  ]
}
