{
  "schema_version": 3,
  "preset": {
    "programme": "nsf-nairr-pilot",
    "process": "Classroom allocation",
    "reference_url": "https://nairrpilot.org/opportunities/education-call",
    "reference_title": "NAIRR Pilot classroom call",
    "category": "programme",
    "tags": [
      "AI",
      "rolling",
      "education",
      "classroom"
    ],
    "summary": "Modelled on the NAIRR Pilot classroom call: course allocations, continuously open, checked for eligibility and resource fit."
  },
  "call": {
    "name": "Classroom allocation",
    "description": "Modelled on the NAIRR Pilot classroom call: allocations for courses with AI content, continuously open. Each request is checked for the course's alignment and readiness -- the instructor or a teaching assistant gives first-line support to students -- and for the fit of the requested resources, then decided by the call managers. The allocation covers the course's dates (three, six or twelve months) and ends with a short teaching outcome report.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": null,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "on_submission",
    "carry_over_drafts": true,
    "publish_results": "immediately",
    "undecided_at_round_completion": "refuse",
    "allowed_duration_months": [
      3,
      6,
      12
    ],
    "target_decision_days": 14
  },
  "proposal_roles": [],
  "workflow_steps": [
    {
      "key": "eligibility_check",
      "kind": "decision",
      "name": "Eligibility check",
      "description": "The call managers check that the instructor teaches at an eligible institution, that the course has AI content, and that the course is ready: dates, syllabus, and who supports the students. They may ask for changes.",
      "outcome_set": "eligibility",
      "completer": "call_manager",
      "completer_proposal_role": null,
      "on_negative": "reject",
      "is_enabled": true,
      "duration_in_days": 5,
      "transition_mode": "automatic_on_completion",
      "contributor_source": "none",
      "input_steps": [],
      "assigns_roles": [],
      "criteria": [],
