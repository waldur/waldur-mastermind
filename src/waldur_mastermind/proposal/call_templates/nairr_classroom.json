  "checklists": [
    {
      "name": "Teaching outcome report",
      "checklist_type": "workflow_step",
      "description": "What a course did with its allocation once the course has ended.",
      "questions": [
        {
          "description": "Teaching outcomes",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "Describe how the students used the resources, how many took part and what the course achieved with them.",
          "rich_text_char_limit": 5000,
          "rich_text_toolbar_level": "minimal"
        }
      ]
    }
  ],
  "scenarios": [
    {
      "key": "happy_path",
      "name": "Happy path",
      "description": "Eligible, the resources fit the course and the allocation is approved; the final report closes the project.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "eligible"
          },
          {
            "step": "resource_fit",
            "outcome": "feasible"
          },
          {
            "step": "allocation_decision",
            "outcome": "approved"
          },
          {
            "final_report": true
          },
          {
            "step": "final_report",
            "outcome": "submitted"
          },
          {
            "step": "final_report_approval",
            "outcome": "approved"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "accepted"
        },
        {
          "step_status": {
            "step": "eligibility_check",
            "status": "completed",
            "outcome": "eligible"
          }
        },
        {
          "step_status": {
            "step": "allocation_decision",
            "status": "completed",
            "outcome": "approved"
          }
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_submitted"
          }
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_decided"
          }
        },
        {
          "step_status": {
            "step": "final_report",
            "status": "completed",
            "outcome": "submitted"
          }
        },
        {
          "step_status": {
            "step": "final_report_approval",
            "status": "completed",
            "outcome": "approved"
          }
        }
      ]
    },
    {
      "key": "rejected_at_eligibility_check",
      "name": "Rejected at the eligibility check",
      "description": "The proposal is found ineligible: it is rejected, the applicant is told and no other step runs.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "ineligible"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "rejected"
        },
        {
          "step_status": {
            "step": "eligibility_check",
            "status": "completed",
            "outcome": "ineligible"
          }
        },
        {
          "step_status": {
            "step": "resource_fit",
            "status": "pending"
          }
        },
        {
          "ends_at": "eligibility_check"
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_decided"
          }
        }
      ]
    },
    {
      "key": "changes_requested_at_eligibility_check",
      "name": "Changes requested at the eligibility check",
      "description": "The proposal goes back to the applicant for changes, is resubmitted and found eligible.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "request_changes": true,
            "message": "Please complete the project description."
          },
          {
            "submit_changes": true
          },
          {
            "step": "eligibility_check",
            "outcome": "eligible"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "in_review"
        },
        {
          "notified": {
            "actor": "applicant",
            "trigger": "changes_requested",
            "step": "eligibility_check"
          }
        },
        {
          "step_status": {
            "step": "eligibility_check",
            "status": "completed",
            "outcome": "eligible"
          }
        },
        {
          "step_status": {
            "step": "resource_fit",
            "status": "active"
          }
        }
      ]
    },
    {
      "key": "rejected_at_resource_fit",
      "name": "Rejected at the resource fit",
      "description": "No requested resource fits the course: the proposal is rejected.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "eligibility_check",
            "outcome": "eligible"
          },
          {
            "step": "resource_fit",
            "outcome": "infeasible"
          }
        ]
      },
      "assertions": [
        {
          "proposal_state": "rejected"
        },
        {
          "step_status": {
            "step": "resource_fit",
            "status": "completed",
            "outcome": "infeasible"
          }
        },
        {
          "step_status": {
            "step": "allocation_decision",
            "status": "pending"
          }
        },
        {
          "ends_at": "resource_fit"
        }
      ]
    }
