        {
          "notified": {
            "actor": "applicant",
            "trigger": "proposal_decided"
          }
        }
      ]
    },
    {
      "key": "technical_assessment_reopened",
      "name": "Technical assessment reopened",
      "description": "A partition submits its assessment, the call managers reopen it for a correction and the proposal is then accepted.",
      "request": {
        "offerings": 2,
        "actions": [
          {
            "step": "technical_assessment",
            "contributions": [
              {
                "offering": 0,
