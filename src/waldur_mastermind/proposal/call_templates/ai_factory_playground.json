{
  "schema_version": 3,
  "preset": {
    "programme": "eurohpc-ju-access",
    "process": "AI Factories Playground Access",
    "reference_url": "https://eurohpc-ju.europa.eu/playground-access-ai-factories_en",
    "reference_title": "Playground Access to AI Factories",
    "category": "programme",
    "tags": [
      "AI",
      "industry",
      "continuous"
    ],
    "summary": "Entry-level access to AI Factories for SMEs and start-ups, open continuously and assessed on a rolling basis."
  },
  "call": {
    "name": "AI Factory Playground Access",
    "description": "Quick access for industrial AI users new to HPC or with smaller computational needs, continuously open with no submission cut-off and evaluated on a rolling basis: each proposal is assessed by the requested AI Factories as soon as it is submitted, and the result is communicated right after the decision.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": null,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "on_submission",
    "carry_over_drafts": true,
    "publish_results": "immediately",
    "undecided_at_round_completion": "refuse",
    "target_decision_days": 4,
    "applicant_cc_roles": [
      "PROPOSAL.MANAGER",
      "PROPOSAL.ADMIN"
    ]
  },
  "proposal_roles": [],
  "workflow_steps": [
