      "key": "technical_assessment",
      "kind": "assessment",
      "name": "Technical assessment",
      "description": "The team of each requested partition (the AI Factory's computing centre representative or a technical reviewer they delegate to) assesses whether the proposal can run there: accepted or rejected. A proposal rejected on any partition is not awarded. The step completes on its own once every partition is assessed.",
      "status_labels": {
        "evaluators": {
          "active": "Under Technical Assessment"
        }
      },
      "outcome_set": "per_offering",
      "completer": "offering_manager",
      "completer_proposal_role": null,
      "on_negative": "reject",
