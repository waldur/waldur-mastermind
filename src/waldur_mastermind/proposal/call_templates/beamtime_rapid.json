    "summary": "Modelled on ESRF rolling access: submit any time, a feasibility assessment and one review within three weeks."
  },
  "call": {
    "name": "Beamtime: rapid access",
    "description": "Modelled on the rolling access route of the ESRF (MX Rolling); ISIS, ILL and similar facilities run comparable rapid routes. Proposals are accepted at any time and reviewed within three weeks: an eligibility check, the feasibility assessment by the scientists of each requested instrument, and one review, before the call managers decide. The beamtime is scheduled within three months, and the experiment report is due within two months of it (a default).",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": 92,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "on_submission",
    "carry_over_drafts": true,
    "publish_results": "immediately",
    "undecided_at_round_completion": "refuse",
    "target_decision_days": 21
  },
