{
  "schema_version": 3,
  "preset": {
    "programme": "nsf-nairr-pilot",
    "process": "Monthly merit review and resource matching",
    "reference_url": "https://nairrpilot.org/opportunities/allocations",
    "reference_title": "NAIRR Pilot allocations",
    "category": "programme",
    "tags": [
      "AI",
      "monthly",
      "peer review",
      "resource matching"
    ],
    "summary": "Modelled on the NAIRR Pilot research allocations: monthly cut-offs, merit review, then matching with the resource providers."
  },
  "call": {
    "name": "Research allocation with resource matching",
    "description": "Modelled on the NAIRR Pilot research allocations: open until the resources are committed, with proposals reviewed after monthly cut-offs (submit by the cut-off, decision by the end of the following month). Each proposal gets a merit review by independent reviewers; the teams of the requested resources then match the approved proposals with their resources before the call managers decide. Awards run twelve months and end with a final report. The updates at one and six months are not modelled.",
    "reference_code": "",
    "external_url": null,
    "reviewer_identity_visible_to_submitters": false,
    "reviews_visible_to_submitters": false,
    "fixed_duration_in_days": 365,
    "proposal_slug_template": null,
    "order_author": "applicant",
    "evaluation_start": "at_cutoff",
    "carry_over_drafts": true,
    "publish_results": "with_round",
    "undecided_at_round_completion": "refuse",
    "target_decision_days": 45
  },
