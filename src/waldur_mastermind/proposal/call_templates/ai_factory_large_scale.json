  "checklists": [
    {
      "name": "Industrial Innovation Group evaluation",
      "checklist_type": "workflow_step",
      "description": "An AI Factory's Industrial Innovation Group evaluation of the proposal.",
      "questions": [
        {
          "description": "Assessment of innovation and impact",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "Assess the innovation and the expected impact of the proposal for the AI Factory.",
          "rich_text_char_limit": 10000,
          "rich_text_toolbar_level": "minimal"
        },
        {
          "description": "Score: Innovation and impact",
          "required": true,
          "question_type": "rating",
          "user_guidance": "From 1 (poor) to 5 (excellent).",
          "min_value": 1,
          "max_value": 5
        }
      ]
    },
    {
      "name": "Final report",
      "checklist_type": "workflow_step",
      "description": "The results of an awarded project once its allocation ends.",
      "questions": [
        {
          "description": "Final results of the work",
          "required": true,
          "question_type": "rich_text",
          "user_guidance": "Report what the project achieved with the allocated resources, including publications and outcomes.",
          "rich_text_char_limit": 10000,
          "rich_text_toolbar_level": "minimal"
        },
        {
          "description": "Final report document",
          "required": false,
          "question_type": "file",
          "user_guidance": "Optional. One PDF file with the full report.",
          "allowed_file_types": [
            ".pdf"
          ],
          "allowed_mime_types": [
            "application/pdf"
          ],
          "max_file_size_mb": 10
        }
      ]
    }
