# Django settings for Waldur Core

from waldur_core.server.base_settings import *

# Debugging
DEBUG = False

# Allowed hosts
ALLOWED_HOSTS = ['127.0.0.1', 'localhost']

# Secret key
# SECURITY WARNING: keep the secret key used in production secret!
# You can use this command to generate a new secret key:
#
#   head -c32 /dev/urandom | base64
#
SECRET_KEY = '...'

# Databases
DATABASES = {
     'default': {
        'ENGINE': 'django.db.backends.postgresql',
        'NAME': 'waldur',
        'USER': 'waldur',
        'PASSWORD': 'waldur',
        'HOST': 'localhost',
        'PORT': '5432',
    }
}


CELERY_RESULT_BACKEND = f"db+postgresql+psycopg://{DATABASES['default']['USER']}:{DATABASES['default']['PASSWORD']}@{DATABASES['default']['HOST']}:{DATABASES['default']['PORT']}/{DATABASES['default']['NAME']}"

# The absolute path to the directory where collectstatic will collect static files for deployment.
STATIC_ROOT = 'static'

# Logging - structlog is configured in base_settings (JSON to console + database).
# Override LOGGING here to customize. Set WALDUR_DEV_LOGS=1 for readable console output.
# See docs/core-concepts/logging.md

# Settings, that are related to Waldur Core
WALDUR_CORE.update({
    'EXTENSIONS_AUTOREGISTER': True,
})

# Seller country code is used for computing VAT charge rate
WALDUR_CORE['SELLER_COUNTRY_CODE'] = 'EE'

DEFAULT_FROM_EMAIL='noreply@example.com'
DEFAULT_REPLY_TO_EMAIL = 'support@example.com'
