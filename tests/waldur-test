#!/usr/bin/env sh
# This script is the final executor for running pytest in a CI environment.
# It is designed to be a "dumb" executor, receiving all its instructions
# via command-line arguments and environment variables. The "intelligent"
# decision-making (e.g., selecting tests, deciding to parallelize) happens
# in a preceding CI job that triggers the pipeline this script runs in.

# Exit immediately if a command exits with a non-zero status.
set -e

# --- ARGUMENT PARSING ---
# This script expects three arguments to be passed from the GitLab CI job.

# Argument 1: The mode of testing (e.g., "UNIT", "MANAGEMENT").
# Default to "UNIT" for safety, though it should always be provided.
TEST_MODE="${1}"

# Argument 2: A space-separated string of test paths to run.
# e.g., "src/waldur_aws src/waldur_core/structure"
# This is passed from the parent pipeline's TEST_PATHS variable.
TEST_TARGETS="${2}"

# Argument 3: A boolean flag ('true' or 'false') indicating whether to
# enable parallel test splitting. This is determined by the parent pipeline.
ENABLE_SPLITTING="${3}"


# --- SCRIPT EXECUTION ---

echo "--- Waldur Test Runner ---"
echo "  Mode:              ${TEST_MODE}"
echo "  Targets:           ${TEST_TARGETS}"
echo "  Splitting Enabled: ${ENABLE_SPLITTING}"
echo "--------------------------"


# --- STEP 1: ENVIRONMENT SETUP ---
# Although dependencies were likely installed in the parent job for test discovery,
# we re-run the installation here to ensure the environment in this (potentially child pipeline)
# job is pristine and correct. `uv` is fast, so this is a low-cost safety measure.
echo "[+] Installing project dependencies..."
pip3 install uv

# Use system Python environment (no venv) since the test image has dependencies pre-installed
echo "[+] Install dependencies and package using lock file"
echo "[+] Python prefix: $(python -c 'import sysconfig; print(sysconfig.get_config_var("prefix"))')"
export UV_PROJECT_ENVIRONMENT=$(python -c "import sysconfig; print(sysconfig.get_config_var('prefix'))")
echo "[+] UV_PROJECT_ENVIRONMENT set to: $UV_PROJECT_ENVIRONMENT"

# Install the project in editable mode with dev dependencies
echo "[+] Installing project with dev dependencies into system Python"
uv pip install --python $(which python) -e ".[dev]"

# Verify pytest is available
echo "[+] Verifying pytest installation"
python -c "import pytest; print(f'pytest {pytest.__version__} is available')"

echo "[+] Setting up test database configuration..."
# This heredoc creates a temporary settings file for pytest to use,
# pointing it to the PostgreSQL service container provided by GitLab CI.
cat > src/waldur_mastermind/test_settings.py <<-EOF
from waldur_core.server.test_settings import *
from django.db.backends.base.schema import BaseDatabaseSchemaEditor

# Using UNLOGGED tables in PostgreSQL is a significant performance boost for
# tests, as it reduces disk I/O by not writing to the WAL.
BaseDatabaseSchemaEditor.sql_create_table = "CREATE UNLOGGED TABLE %(table)s (%(definition)s)"

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.postgresql',
        'NAME': 'test_waldur',
        'USER': 'runner',
        'HOST': 'postgres',
        'PORT': 5432,
        'PASSWORD': 'waldur',
    }
}
EOF


# --- STEP 2: DYNAMIC PYTEST COMMAND CONSTRUCTION ---
# We build the final pytest command as a string, adding flags conditionally.

if [ "$TEST_MODE" = "UNIT" ]; then
  # Base command with flags that are always used for unit tests.
  PYTEST_BASE_CMD="pytest \
      --reuse-db \
      --junitxml=report.xml \
      --cov=src/ \
      --no-migrations \
      -ra \
      --ds=waldur_mastermind.test_settings"

  # This is the core logic for parallelization.
  # The command will only be split if the parent job decided it was necessary
  # AND if we are actually in a parallel GitLab CI environment (i.e., $CI_NODE_TOTAL is set).
  SPLITTING_ARGS=""
  if [ "$ENABLE_SPLITTING" = "true" ] && [ -n "$CI_NODE_TOTAL" ]; then
    echo "[+] Splitting is enabled and CI parallel variables are present. Adding group flags."
    SPLITTING_ARGS="--test-group-count $CI_NODE_TOTAL \
      --test-group=$CI_NODE_INDEX \
      --test-group-random-seed=12345"
  else
    echo "[+] Splitting is disabled or not in a parallel environment. Running as a single group."
  fi

  # Combine the base command, splitting arguments, and test targets.
  FINAL_PYTEST_CMD="${PYTEST_BASE_CMD} ${SPLITTING_ARGS} ${TEST_TARGETS}"

elif [ "$TEST_MODE" = "MANAGEMENT" ]; then
  # Management command tests are typically a small, specific set.
  # We run them as a single job without any selection or splitting.
  echo "[+] Configuring for management command tests."
  FINAL_PYTEST_CMD="pytest \
      --junitxml=report.xml \
      --cov=src/ \
      --create-db \
      --ds=waldur_mastermind.test_settings \
      src/waldur_core/core/tests/test_management.py"
else
  echo "ERROR: UNKNOWN TEST MODE: $TEST_MODE"
  exit 1
fi


# --- STEP 3: EXECUTION & REPORTING ---
echo "[+] Final pytest command to be executed:"
echo "----------------------------------------------------"
echo "$FINAL_PYTEST_CMD"
echo "----------------------------------------------------"

# Use `eval` to execute the command string. This is necessary to ensure that
# all the arguments, quotes, and flags are interpreted correctly by the shell.
eval $FINAL_PYTEST_CMD

# These final steps will only be reached if the `eval` command (pytest)
# exits with a status code of 0.
echo "[+] Tests completed. Generating coverage reports..."
coverage xml
coverage report

echo "[+] Test runner finished successfully."
