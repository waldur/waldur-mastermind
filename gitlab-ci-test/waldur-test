#!/usr/bin/env sh
set -e

TEST_MODE="${1:-UNIT}"
# The second argument is a space-separated list of test paths. Default to 'src' for backward compatibility.
TEST_TARGETS="${2:-src}"

# If TEST_TARGETS is empty, there's nothing to test.
if [ -z "$TEST_TARGETS" ]; then
  echo "[+] No test targets selected. Exiting successfully."
  exit 0
fi

echo "[+] Test mode: $TEST_MODE"
echo "[+] Test targets: $TEST_TARGETS"

echo "[+] Install dependencies in case of absence"
pip3 install uv

# Use system Python environment (no venv) since the test image has dependencies pre-installed
echo "[+] Install dependencies and package using lock file"
echo "[+] Python prefix: $(python -c 'import sysconfig; print(sysconfig.get_config_var("prefix"))')"
export UV_PROJECT_ENVIRONMENT=$(python -c "import sysconfig; print(sysconfig.get_config_var('prefix'))")
echo "[+] UV_PROJECT_ENVIRONMENT set to: $UV_PROJECT_ENVIRONMENT"

# Install the project in editable mode with dev dependencies
echo "[+] Installing project with dev dependencies into system Python"
uv pip install --python $(which python) -e ".[dev]"

# Verify pytest is available
echo "[+] Verifying pytest installation"
python -c "import pytest; print(f'pytest {pytest.__version__} is available')"

echo "[+] Setup test settings"
cat > src/waldur_mastermind/test_settings.py <<-EOF
from waldur_core.server.test_settings import *
from django.db.backends.base.schema import BaseDatabaseSchemaEditor

# Data written to unlogged tables is not written to the write-ahead log,
# which makes them considerably faster than ordinary tables.
BaseDatabaseSchemaEditor.sql_create_table = "CREATE UNLOGGED TABLE %(table)s (%(definition)s)"

DATABASES = {
'default': {
  'ENGINE': 'django.db.backends.postgresql',
  'NAME': 'test_waldur',
  'USER': 'runner',
  'HOST': 'postgres',
  'PORT': 5432,
  'PASSWORD': 'waldur',
  }
}
EOF

if [ "$TEST_MODE" = "UNIT" ]; then
  echo "[+] Running unit tests without migrations"
  pytest \
      --test-group-count $CI_NODE_TOTAL \
      --test-group=$CI_NODE_INDEX \
      --test-group-random-seed=12345 \
      --reuse-db \
      --junitxml=report.xml \
      --cov=src/ \
      --no-migrations \
      -ra \
      --ds=waldur_mastermind.test_settings \
      $TEST_TARGETS

  # Check default configuration
  DJANGO_SETTINGS_MODULE=waldur_mastermind.test_settings waldur print_settings > /dev/null
elif [ "$TEST_MODE" = "MANAGEMENT" ]; then
  echo "[+] Running tests for management commands"
  pytest \
      --junitxml=report.xml \
      --cov=src/ \
      --create-db \
      --ds=waldur_mastermind.test_settings \
      src/waldur_core/core/tests/test_management.py
else
  echo "UNKNOWN TEST MODE: $TEST_MODE"
  exit 1
fi
